<article class="post-card">
	<a class="post-card__media" href="/stories/<%= post.slug %>" tabindex="-1" aria-hidden="true">
		<% if (post.cover) { %>
			<img class="post-card__image" src="<%= post.cover %>" alt="" loading="lazy" decoding="async">
		<% } else { %>
			<span class="post-card__pattern"></span>
			<span class="post-card__date">
				<span class="post-card__date-day"><%= h.formatDate(post.published_at || post.created_at, 'short').split(' ')[0] %></span>
				<span class="post-card__date-month"><%= h.formatDate(post.published_at || post.created_at, 'short').split(' ')[1] %></span>
			</span>
		<% } %>
	</a>

	<div class="post-card__body">
		<ul class="post-card__meta">
			<% if (post.category) { %><li><%= post.category %></li><% } %>
			<li><time datetime="<%= post.published_at || post.created_at %>"><%= h.formatDate(post.published_at || post.created_at) %></time></li>
		</ul>
		<h3 class="post-card__title"><a href="/stories/<%= post.slug %>"><%= post.title %></a></h3>
		<p class="post-card__excerpt"><%= h.truncate(post.excerpt || post.content, 130) %></p>
		<a class="post-card__more" href="/stories/<%= post.slug %>">Read story <%- h.icon('arrow-up-right', 14) %></a>
	</div>
</article>

# ---------------------------------------------------------------------------
# Fill The Gap Africa — environment configuration
# Copy this file to `.env` on the server and fill in the values.
# ---------------------------------------------------------------------------

# Production settings
NODE_ENV=production
PORT=3000

# The public address of the site (no trailing slash). Used for canonical URLs,
# social sharing links and the sitemap.
BASE_URL=https://fillthegapafrica.org

# REQUIRED: a long random string. Changing it signs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to true when the site is served over HTTPS (recommended in production)
COOKIE_SECURE=true

# First administrator. Only used the first time the app starts, when the
# users table is empty. Change the password from Settings > Your account after
# signing in.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@fillthegapafrica.org
ADMIN_PASSWORD=ChangeMe123!

# Storage. Defaults are inside the application folder.
# DATA_DIR=./data
# UPLOAD_DIR=./public/uploads

# Maximum upload size in megabytes
MAX_UPLOAD_MB=8

# ---------------------------------------------------------------------------
# Email notifications (optional). Without SMTP the contact form still stores
# every message in the dashboard under Messages.
# ---------------------------------------------------------------------------
# SMTP_HOST=mail.fillthegapafrica.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=website@fillthegapafrica.org
# SMTP_PASS=your-email-password
# MAIL_FROM="Fill The Gap Africa <website@fillthegapafrica.org>"
# MAIL_TO=info@fillthegapafrica.org

# Private admin path (default /ftga-studio). Change it after install.
ADMIN_PATH=/ftga-studio

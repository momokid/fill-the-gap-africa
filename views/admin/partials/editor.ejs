<div class="field">
	<label><%= label %></label>
	<div class="editor" data-editor>
		<div class="editor__toolbar" role="toolbar" aria-label="Formatting">
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="formatBlock" data-value="h2" title="Heading 2">H2</button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="formatBlock" data-value="h3" title="Heading 3">H3</button>
			<button class="editor__tool" type="button" data-cmd="bold" title="Bold"><strong>B</strong></button>
			<button class="editor__tool" type="button" data-cmd="italic" title="Italic"><em>I</em></button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="insertUnorderedList" title="Bulleted list">• List</button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="insertOrderedList" title="Numbered list">1. List</button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="formatBlock" data-value="blockquote" title="Quote">Quote</button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="createLink" title="Add link">Link</button>
			<button class="editor__tool editor__tool--wide" type="button" data-cmd="removeFormat" title="Clear formatting">Clear</button>
		</div>
		<div class="editor__surface" contenteditable="true" data-placeholder="Write the content…"></div>
		<textarea name="<%= name %>" hidden><%= value %></textarea>
	</div>
	<% if (typeof hint !== 'undefined' && hint) { %><span class="hint"><%= hint %></span><% } %>
</div>

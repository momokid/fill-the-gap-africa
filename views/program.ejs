<%- include('partials/head') %>
<%- include('partials/header') %>

<%- include('partials/page-hero', {
	title: program.title,
	eyebrow: 'Program',
	titleHtml: program.title,
	lede: program.summary,
	crumb: { label: 'Programs', url: '/programs' }
}) %>

<article class="section single-program">
	<div class="container single-program__grid">
		<div class="single-program__main">
			<% if (program.cover) { %>
				<figure class="single-program__media">
					<img src="<%= program.cover %>" alt="<%= program.title %>" loading="eager" decoding="async">
				</figure>
			<% } %>

			<div class="prose">
				<%- program.content %>
			</div>

			<div class="single-story__footer">
				<div class="share">
					<span class="share__label">Share</span>
					<a class="share__link" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(baseUrl + '/programs/' + program.slug) %>" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><%- h.icon('facebook', 16) %></a>
					<a class="share__link" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(baseUrl + '/programs/' + program.slug) %>&text=<%= encodeURIComponent(program.title) %>" target="_blank" rel="noopener noreferrer" aria-label="Share on X"><%- h.icon('x', 16) %></a>
					<a class="share__link" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(baseUrl + '/programs/' + program.slug) %>" target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn"><%- h.icon('linkedin', 16) %></a>
					<a class="share__link" href="mailto:?subject=<%= encodeURIComponent(program.title) %>&body=<%= encodeURIComponent(baseUrl + '/programs/' + program.slug) %>" aria-label="Share by email"><%- h.icon('mail', 16) %></a>
				</div>
			</div>
		</div>

		<aside class="single-program__aside">
			<div class="aside-card aside-card--program">
				<span class="aside-card__icon"><%- h.icon(program.icon, 26) %></span>
				<h2 class="aside-card__title">Make this possible</h2>
				<p>This program is funded by people and institutions who want a specific result, not a general promise.</p>
				<a class="btn btn--primary btn--block" href="/donate">Donate <%- h.icon('heart', 16) %></a>
				<a class="btn btn--ghost btn--block" href="/get-involved">Volunteer or partner</a>
			</div>

			<% if (others.length) { %>
				<div class="aside-card">
					<h2 class="aside-card__title">Other programs</h2>
					<ul class="aside-links">
						<% others.forEach(function (other) { %>
							<li>
								<a href="/programs/<%= other.slug %>">
									<span><%= other.title %></span>
									<%- h.icon('arrow-right', 14) %>
								</a>
							</li>
						<% }); %>
					</ul>
				</div>
			<% } %>
		</aside>
	</div>
</article>

<%- include('partials/cta') %>
<%- include('partials/footer') %>

<a class="program-card" href="/programs/<%= program.slug %>">
	<span class="program-card__media program-card__media--<%= program.icon %>" aria-hidden="true">
		<span class="program-card__pattern"></span>
		<span class="program-card__num"><%= String(index + 1).padStart(2, '0') %></span>
		<span class="program-card__icon"><%- h.icon(program.icon, 26) %></span>
		<% if (program.cover) { %>
			<img class="program-card__image" src="<%= program.cover %>" alt="" loading="lazy" decoding="async">
		<% } %>
	</span>
	<span class="program-card__body">
		<span class="program-card__title"><%= program.title %></span>
		<span class="program-card__text"><%= program.summary %></span>
		<span class="program-card__link">Explore program <%- h.icon('arrow-up-right', 16) %></span>
	</span>
</a>

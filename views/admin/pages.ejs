<%- include('partials/head') %>

<div class="page-head">
	<div>
		<h2>Pages</h2>
		<p class="page-head__desc">Standalone pages such as About, Impact and Donate. Each uses a layout template, so the design stays consistent.</p>
	</div>
	<div class="actions">
		<a class="button button--primary" href="<%= adminBase %>/pages/new"><%- h.icon('plus', 15) %> New page</a>
	</div>
</div>

<div class="card">
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr><th>Title</th><th>Layout</th><th>Status</th><th style="text-align:right;">Actions</th></tr>
			</thead>
			<tbody>
				<% const labels = { default: 'Standard page', about: 'About', programs: 'Programs', impact: 'Impact', 'get-involved': 'Get involved', donate: 'Donate', contact: 'Contact' }; %>
				<% pages.forEach(function (page) { %>
					<tr>
						<td>
							<a class="table__title" href="<%= adminBase %>/pages/<%= page.id %>/edit"><%= page.title %></a>
							<span class="table__sub">/<%= page.slug %></span>
						</td>
						<td><span class="badge"><%= labels[page.template] || page.template %></span></td>
						<td><span class="badge badge--<%= page.status %>"><%= page.status %></span></td>
						<td>
							<div class="table__actions">
								<a class="button button--sm" href="/<%= page.slug %>" target="_blank" rel="noopener">View</a>
								<a class="button button--sm" href="<%= adminBase %>/pages/<%= page.id %>/edit">Edit</a>
								<% if (!['about', 'programs', 'impact', 'get-involved', 'donate', 'contact', 'privacy'].includes(page.slug)) { %>
									<form method="post" action="<%= adminBase %>/pages/<%= page.id %>/delete" data-confirm="Delete the page “<%= page.title %>”?">
										<input type="hidden" name="_csrf" value="<%= csrfToken %>">
										<button class="button button--sm button--danger" type="submit">Delete</button>
									</form>
								<% } %>
							</div>
						</td>
					</tr>
				<% }); %>
			</tbody>
		</table>
	</div>
</div>

<%- include('partials/foot') %>

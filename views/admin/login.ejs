<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Sign in, <%= site.site_name %></title>
	<meta name="robots" content="noindex, nofollow">
	<link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..600&family=Inter:wght@400;500;600;700&display=swap">
	<link rel="stylesheet" href="/css/admin.css?v=7">
</head>
<body>
<div class="login">
	<div class="login__art">
 <div class="login__seal" aria-hidden="true"></div>
 <a class="sidebar__brand" href="/" style="padding-left:0; border-bottom:0;">
 <% if (site.logo) { %><img class="brand-logo" src="<%= site.logo %>" alt="" style="max-height:42px;"><% } else { %><%- h.logoMark(40) %><% } %>
 <span>
 <span class="sidebar__brand-name"><%= site.site_name %></span>
 <span class="sidebar__brand-sub">Est. 2011 · Accra</span>
 </span>
 </a>
 <div>
 <h1>Tell the story of the work.</h1>
 <p>Publish stories, announce events, manage programs and keep the site current, without touching code.</p>
 </div>
	</div>

	<div class="login__panel">
 <div class="login__card">
 <div class="login__brand">
 <% if (site.logo) { %><img class="brand-logo" src="<%= site.logo %>" alt="" style="max-height:34px;"><% } else { %><%- h.logoMark(34) %><% } %>
 <span class="sidebar__brand-sub" style="color: var(--a-muted);">Content studio</span>
 </div>

 <h2 class="login__title">Welcome back</h2>
 <p class="login__sub">Sign in to manage the website.</p>

 <% if (error) { %>
 <div class="flash flash--error login__error" role="alert">
 <%- h.icon('close', 17) %>
 <span><%= error %></span>
 </div>
 <% } %>

 <form class="form" method="post" action="<%= adminBase %>/login">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <input type="hidden" name="next" value="<%= next %>">

 <div class="field">
 <label for="email">Email address</label>
 <input type="email" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
 </div>

 <div class="field">
 <label for="password">Password</label>
 <input type="password" id="password" name="password" autocomplete="current-password" required>
 </div>

 <button class="button button--primary button--block" type="submit">Sign in</button>
 </form>

 <div class="login__foot">
 <span><%= site.site_name %></span>
 <a class="link-quiet" href="/">Back to site</a>
 </div>
 </div>
	</div>
</div>
</body>
</html>
